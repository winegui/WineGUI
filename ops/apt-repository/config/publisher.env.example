# Install as /etc/winegui-apt-publisher.env with mode 0640 and root ownership.
WINEGUI_APT_STATE_ROOT=/var/lib/winegui-apt
WINEGUI_APT_SPOOL_ROOT=/var/spool/winegui-apt
WINEGUI_APT_PUBLIC_ROOT=/var/www/apt.winegui.melroy.org/html
WINEGUI_APT_REPREPRO_CONFIG=/var/lib/winegui-apt/reprepro/conf
WINEGUI_APT_GNUPGHOME=/var/lib/winegui-apt/gnupg
WINEGUI_APT_SIGNING_KEY=REPLACE_WITH_FULL_SIGNING_SUBKEY_FINGERPRINT
WINEGUI_APT_REPREPRO=/usr/local/lib/winegui-reprepro/bin/reprepro
WINEGUI_APT_DPKG_DEB=/usr/bin/dpkg-deb
WINEGUI_APT_GPG=/usr/bin/gpg
WINEGUI_APT_LOCK_FILE=/run/lock/winegui-apt-publisher.lock
